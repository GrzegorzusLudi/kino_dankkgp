{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "vertical-separator",
  "prefix": "lib",
  "projectType": "library",
  "sourceRoot": "libs/vertical-separator/src",
  "tags": [],
  "targets": {
    "chores": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run vertical-separator:lint:fix",
          "nx run vertical-separator:format"
        ],
        "parallel": false
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --write \"libs/vertical-separator/\""
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "lint:fix": {
      "executor": "@nx/eslint:lint",
      "options": {
        "fix": true
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "config": "libs/vertical-separator/vite.config.mts"
      }
    }
  }
}
