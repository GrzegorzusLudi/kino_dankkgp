{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "button",
  "prefix": "lib",
  "projectType": "library",
  "sourceRoot": "libs/button/src",
  "tags": [],
  "targets": {
    "chores": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run button:lint:fix",
          "nx run button:lint:styles:fix",
          "nx run button:format"
        ],
        "parallel": false
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --write \"libs/button/\""
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "lint:fix": {
      "executor": "@nx/eslint:lint",
      "options": {
        "fix": true
      }
    },
    "lint:styles": {
      "executor": "nx:run-commands",
      "options": {
        "command": "stylelint \"libs/button/**/*.scss\" --allow-empty-input"
      }
    },
    "lint:styles:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "stylelint \"libs/button/**/*.scss\" --allow-empty-input --fix"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "config": "libs/button/vite.config.mts"
      }
    }
  }
}
