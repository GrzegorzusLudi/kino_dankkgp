{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "theme",
  "prefix": "lib",
  "projectType": "library",
  "sourceRoot": "libs/theme/src",
  "tags": [],
  "targets": {
    "build-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook build -o ../../dist/storybook/theme",
        "cwd": "libs/theme"
      }
    },
    "chores": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run theme:lint:fix",
          "nx run theme:lint:styles:fix",
          "nx run theme:format"
        ],
        "parallel": false
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook dev -p 4400",
        "cwd": "libs/theme"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --write \"libs/theme/\""
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "lint:fix": {
      "executor": "@nx/eslint:lint",
      "options": {
        "fix": true
      }
    },
    "lint:styles": {
      "executor": "nx:run-commands",
      "options": {
        "command": "stylelint \"libs/theme/**/*.scss\" --allow-empty-input"
      }
    },
    "lint:styles:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "stylelint \"libs/theme/**/*.scss\" --allow-empty-input --fix"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "config": "libs/theme/vite.config.mts"
      }
    }
  }
}
