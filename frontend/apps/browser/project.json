{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "browser",
  "prefix": "app",
  "projectType": "application",
  "root": "apps/browser",
  "sourceRoot": "apps/browser/src",
  "tags": [],
  "targets": {
    "build": {
      "configurations": {
        "development": {
          "command": "node scripts/build.js --configuration=development"
        },
        "production": {
          "command": "node scripts/build.js --configuration=production"
        }
      },
      "defaultConfiguration": "production",
      "dependsOn": ["build-angular"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/build.js --configuration=production",
        "cwd": "{workspaceRoot}"
      }
    },
    "build-angular": {
      "configurations": {
        "development": {
          "extractLicenses": false,
          "fileReplacements": [
            {
              "replace": "apps/browser/src/environments/environment.ts",
              "with": "apps/browser/src/environments/environment.development.ts"
            }
          ],
          "optimization": false,
          "sourceMap": true
        },
        "production": {
          "budgets": [
            {
              "maximumError": "2MB",
              "maximumWarning": "1MB",
              "type": "initial"
            },
            {
              "maximumError": "16kB",
              "maximumWarning": "14kB",
              "type": "anyComponentStyle"
            }
          ],
          "outputHashing": "all"
        }
      },
      "defaultConfiguration": "production",
      "executor": "@angular-devkit/build-angular:application",
      "options": {
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/browser/public"
          }
        ],
        "browser": "apps/browser/src/main.ts",
        "index": "apps/browser/src/index.html",
        "inlineStyleLanguage": "scss",
        "outputPath": "dist/apps/browser",
        "polyfills": [],
        "scripts": [],
        "stylePreprocessorOptions": {
          "includePaths": ["apps/browser/src/app/styles", "libs/theme/src/lib"]
        },
        "styles": ["apps/browser/src/styles.scss"],
        "tsConfig": "apps/browser/tsconfig.app.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n"
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --w apps/browser/**/*.{ts,html,scss,json}",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "lint:fix": {
      "executor": "@angular-eslint/builder:lint",
      "options": {
        "fix": true,
        "lintFilePatterns": [
          "apps/browser/src/**/*.ts",
          "apps/browser/src/**/*.html"
        ]
      }
    },
    "serve": {
      "configurations": {
        "development": {
          "buildTarget": "browser:build-angular:development"
        },
        "production": {
          "buildTarget": "browser:build-angular:production"
        }
      },
      "defaultConfiguration": "development",
      "executor": "@angular-devkit/build-angular:dev-server"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "config": "apps/browser/vite.config.mts"
      }
    },
    "watch": {
      "configurations": {
        "development": {
          "extractLicenses": false,
          "fileReplacements": [
            {
              "replace": "apps/browser/src/environments/environment.ts",
              "with": "apps/browser/src/environments/environment.development.ts"
            }
          ],
          "optimization": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "development",
      "executor": "@angular-devkit/build-angular:application",
      "options": {
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/browser/public"
          }
        ],
        "browser": "apps/browser/src/main.ts",
        "index": "apps/browser/src/index.html",
        "inlineStyleLanguage": "scss",
        "outputPath": "dist/apps/browser",
        "polyfills": [],
        "scripts": [],
        "styles": ["apps/browser/src/styles.scss"],
        "tsConfig": "apps/browser/tsconfig.app.json",
        "watch": true
      }
    }
  }
}
